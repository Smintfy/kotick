{
  "name": "state-viewer",
  "version": "0.0.0",
  "private": true,
  "description": "Preview every state of every XState machine on the page, in place.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@xstate/react": "^5.0.0 || ^6.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "xstate": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@xstate/react": {
      "optional": true
    },
    "xstate": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@xstate/react": "catalog:",
    "jsdom": "^30.1.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "^0.23.1",
    "typescript": "catalog:",
    "vitest": "^5.0.3",
    "xstate": "catalog:"
  },
  "exports": {
    ".": "./src/index.tsx",
    "./xstate": "./src/xstate.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./xstate": "./dist/xstate.js",
      "./package.json": "./package.json"
    }
  }
}
