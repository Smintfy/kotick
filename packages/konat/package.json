{
  "name": "konat",
  "version": "0.1.0",
  "private": true,
  "description": "Preview every state of every state machine on the page, in place. Supports XState v5 and useReducer machines.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build-styles.mjs && tsdown",
    "dev": "node scripts/build-styles.mjs --watch",
    "styles": "node scripts/build-styles.mjs",
    "styles:watch": "node scripts/build-styles.mjs --watch",
    "test": "node scripts/build-styles.mjs --check && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "bench": "vitest bench --run --reporter=verbose"
  },
  "peerDependencies": {
    "@xstate/react": "^6.1.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "xstate": "^5.28.0"
  },
  "peerDependenciesMeta": {
    "@xstate/react": {
      "optional": true
    },
    "xstate": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@xstate/react": "catalog:",
    "jsdom": "^30.1.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.1",
    "typescript": "catalog:",
    "vitest": "^5.0.3",
    "xstate": "catalog:"
  },
  "exports": {
    ".": "./src/index.tsx",
    "./reducer": "./src/reducer.ts",
    "./xstate": "./src/xstate.ts",
    "./package.json": "./package.json",
    "./figure": "./src/figure.tsx"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./reducer": "./dist/reducer.js",
      "./xstate": "./dist/xstate.js",
      "./package.json": "./package.json"
    }
  }
}
