{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "vitest"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["**/dist/**", "**/.next/**", ".claude/**"],
  "rules": {
    // Some loops copy a set or a map before they iterate it, and this rule flags each copy.
    // A loop over the live collection also visits the entries that its callbacks add.
    "unicorn/no-useless-spread": "off",
    "import/no-cycle": "error",
    // A comment states its reason itself. It does not cite the MVP spec, because the spec will be deleted.
    // The terms are the section sign, the word "spec", and the ids of the spec's goals, requirements and decisions.
    "no-warning-comments": [
      "error",
      {
        "location": "anywhere",
        "terms": [
          "§", "spec",
          "G1", "G2", "G3", "G4", "G5", "G6", "G7",
          "R1", "R2", "R3", "R4", "R5", "R6", "R7", "R8", "R9", "R10", "R11", "R12", "R13", "R14",
          "R15", "R16", "R17", "R18", "R19", "R20", "R21", "R22", "R23", "R24", "R25", "R26", "R27", "R28",
          "D1", "D2", "D3", "D4", "D5", "D6", "D7", "D8", "D9", "D10", "D11", "D12", "D13",
          "D14", "D15", "D16", "D17", "D18", "D19", "D20", "D21", "D22", "D23", "D24", "D25"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["packages/state-viewer/src/core/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(react|react-dom|xstate|@xstate/react)(/|$)",
                "message": "The core is in both bundles, so it imports no React and no XState."
              },
              { "regex": "^\\.\\./(overlay|xstate|index)(/|$)", "message": "The core imports no other layer." }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/state-viewer/src/overlay/**", "packages/state-viewer/src/index.tsx"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [
          { "regex": "^(xstate|@xstate/react)(/|$)", "message": "The overlay reads actors through core/types. Only the adapter imports XState." },
          { "regex": "^\\.{1,2}/(\\.\\./)*xstate(/|$)", "message": "The overlay reads actors through core/types. Only the adapter imports XState." }
        ] }]
      }
    },
    {
      // Overrides replace each other's rules, so this one repeats the overlay's.
      "files": ["packages/state-viewer/src/overlay/*.ts"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [
          { "regex": "^(xstate|@xstate/react)(/|$)", "message": "The overlay reads actors through core/types. Only the adapter imports XState." },
          { "regex": "^\\.{1,2}/(\\.\\./)*xstate(/|$)", "message": "The overlay reads actors through core/types. Only the adapter imports XState." },
          { "regex": "^\\./components(/|$)", "message": "Components import the overlay's modules, not the reverse." }
        ] }]
      }
    },
    {
      "files": ["packages/state-viewer/src/xstate/**", "packages/state-viewer/src/xstate.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "regex": "^react-dom(/|$)", "message": "The adapter renders nothing. The overlay owns the DOM." },
              {
                "regex": "^\\.{1,2}/(\\.\\./)*(overlay(/|$)|index$)",
                "message": "The adapter never imports the overlay. They meet only in the core."
              }
            ]
          }
        ]
      }
    },
    {
      // Overrides replace each other's rules, so this one repeats the overlay's.
      "files": ["packages/state-viewer/src/index.tsx"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [
          { "regex": "^(xstate|@xstate/react)(/|$)", "message": "The overlay reads actors through core/types. Only the adapter imports XState." },
          {
            "group": ["./*", "./**", "!./overlay/StateViewer", "!./overlay/props", "!./core/types"],
            "message": "state-viewer exports <StateViewer /> and its types. Test a private function through them."
          }
        ] }]
      }
    },
    {
      // Overrides replace each other's rules, so this one repeats the adapter's.
      "files": ["packages/state-viewer/src/xstate.ts"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [
          { "regex": "^react-dom(/|$)", "message": "The adapter renders nothing. The overlay owns the DOM." },
          {
            "group": ["./*", "./**", "!./xstate/connect", "!./xstate/define-fixtures", "!./xstate/hooks", "!./xstate/options"],
            "message": "state-viewer/xstate exports the hooks, connect(), defineFixtures() and their types. Test a private function through them."
          }
        ] }]
      }
    },
    {
      // Tests use the package the way an app does.
      // The rules are in packages/state-viewer/.claude/skills/writing-tests/SKILL.md.
      "files": ["packages/state-viewer/test/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "regex": "(^|/)src(/|$)", "message": "Import state-viewer and state-viewer/xstate by name." },
              { "regex": "(^|/)xstate/helpers$", "message": "These helpers read private state. Use test/support." }
            ]
          }
        ],
        "no-restricted-properties": [
          "error",
          { "object": "vi", "property": "mock", "message": "No module mocks. Test through the real modules." },
          { "object": "vi", "property": "doMock", "message": "No module mocks. Test through the real modules." },
          { "object": "vi", "property": "hoisted", "message": "No module mocks. Test through the real modules." },
          { "object": "vi", "property": "fn", "message": "No mock functions. Push each call into an array, then assert the array." },
          { "object": "vi", "property": "mocked", "message": "No mock functions. Push each call into an array, then assert the array." },
          { "object": "vi", "property": "spyOn", "message": "No spies. Assert what the code does. Read console output with watchConsole() from test/support/console.ts." },
          { "object": "vi", "property": "stubGlobal", "message": "No stubbed globals. Set up the environment the way a page would." },
          { "object": "vi", "property": "stubEnv", "message": "No stubbed globals. Set up the environment the way a page would." },
          { "object": "vi", "property": "useFakeTimers", "message": "No fake clock. Fire the real event that starts the work, or wait for real time." },
          { "object": "vi", "property": "setSystemTime", "message": "No fake clock. Fire the real event that starts the work, or wait for real time." },
          { "object": "expect", "property": "anything", "message": "Assert the value itself." },
          {
            "object": "globalThis",
            "property": "__STATE_VIEWER_REGISTRY__",
            "message": "The registry is private. Read what the overlay shows."
          },
          {
            "object": "window",
            "property": "__STATE_VIEWER_REGISTRY__",
            "message": "The registry is private. Read what the overlay shows."
          },
          {
            "object": "globalThis",
            "property": "__STATE_VIEWER_LAST_INSTANCE__",
            "message": "The instance counter is private. Read the Instance options that the overlay shows."
          },
          {
            "object": "window",
            "property": "__STATE_VIEWER_LAST_INSTANCE__",
            "message": "The instance counter is private. Read the Instance options that the overlay shows."
          }
        ],
        "vitest/no-restricted-matchers": [
          "error",
          {
            "toBeDefined": "Assert the value itself.",
            "toBeTruthy": "Assert the value itself.",
            "not.toBeTruthy": "Assert the value itself.",
            "toBeFalsy": "Assert the value itself.",
            "not.toBeFalsy": "Assert the value itself."
          }
        ]
      }
    },
    {
      // A type test asserts with @ts-expect-error, which expect-expect can't see.
      "files": ["packages/state-viewer/test/**/*.test-d.ts"],
      "rules": { "vitest/expect-expect": "off" }
    },
    {
      "files": ["packages/state-viewer/bench/**"],
      "rules": { "vitest/expect-expect": "off" }
    },
    {
      // These files were written before the test rules. Never add a file to this list.
      // When black-box tests replace a file, delete the file and its line.
      "files": [
        "packages/state-viewer/test/core/deep-link.test.ts",
        "packages/state-viewer/test/core/fixtures.test.ts",
        "packages/state-viewer/test/core/integration.test.ts",
        "packages/state-viewer/test/core/recording.test.ts",
        "packages/state-viewer/test/core/registry.test.ts",
        "packages/state-viewer/test/overlay/StateViewer.test.tsx",
        "packages/state-viewer/test/overlay/fixtures.test.ts",
        "packages/state-viewer/test/overlay/model.test.ts",
        "packages/state-viewer/test/overlay/settings.test.ts",
        "packages/state-viewer/test/regressions/app-stop-held-across-activity.test.tsx",
        "packages/state-viewer/test/regressions/child-final-recording.test.tsx",
        "packages/state-viewer/test/regressions/complete-during-preview.test.ts",
        "packages/state-viewer/test/regressions/connect-hook-actor.test.tsx",
        "packages/state-viewer/test/regressions/connect-non-root.test.tsx",
        "packages/state-viewer/test/regressions/connect-unstarted-stop.test.tsx",
        "packages/state-viewer/test/regressions/debug-disabled-during-preview.test.tsx",
        "packages/state-viewer/test/regressions/debug-disabled-while-hidden.test.tsx",
        "packages/state-viewer/test/regressions/debug-disabled-without-preview.test.tsx",
        "packages/state-viewer/test/regressions/debug-toggle-observer-memory.test.tsx",
        "packages/state-viewer/test/regressions/deep-link-before-first-paint.test.tsx",
        "packages/state-viewer/test/regressions/errored-child.test.tsx",
        "packages/state-viewer/test/regressions/failed-child-descendants.test.tsx",
        "packages/state-viewer/test/regressions/fallback-id-collision.test.tsx",
        "packages/state-viewer/test/regressions/fallback-id-order.test.tsx",
        "packages/state-viewer/test/regressions/finished-connect-subscriber-retention.test.ts",
        "packages/state-viewer/test/regressions/fixtures-provided-machine.test.tsx",
        "packages/state-viewer/test/regressions/grandchild-final-recording.test.tsx",
        "packages/state-viewer/test/regressions/held-ending-across-actor-replacement.test.tsx",
        "packages/state-viewer/test/regressions/held-ending-dropped-after-told.test.tsx",
        "packages/state-viewer/test/regressions/held-ending-survives-hook-stop.test.tsx",
        "packages/state-viewer/test/regressions/hmr-added-region.test.tsx",
        "packages/state-viewer/test/regressions/hook-start-recording.test.tsx",
        "packages/state-viewer/test/regressions/hook-stop-ends-proxy-subscriptions.test.tsx",
        "packages/state-viewer/test/regressions/instance-ids-across-roots.test.tsx",
        "packages/state-viewer/test/regressions/late-observer-finished-actor.test.tsx",
        "packages/state-viewer/test/regressions/late-subscriber-after-unmount.test.tsx",
        "packages/state-viewer/test/regressions/leaf-id-type.test.tsx",
        "packages/state-viewer/test/regressions/live-warning-before-lazy-fixtures.test.tsx",
        "packages/state-viewer/test/regressions/non-orthogonal-leaves.test.tsx",
        "packages/state-viewer/test/regressions/owed-ending-on-debug-disabled.test.tsx",
        "packages/state-viewer/test/regressions/owed-ending-timing.test.tsx",
        "packages/state-viewer/test/regressions/owed-error-across-replacement.test.tsx",
        "packages/state-viewer/test/regressions/preview-final-output.test.tsx",
        "packages/state-viewer/test/regressions/preview-listener-lifetime.test.tsx",
        "packages/state-viewer/test/regressions/proxy-identity.test.tsx",
        "packages/state-viewer/test/regressions/reentrant-subscribe-during-release.test.ts",
        "packages/state-viewer/test/regressions/replaced-actor-commit-window.test.tsx",
        "packages/state-viewer/test/regressions/replaced-actor-ends-before-passive.test.tsx",
        "packages/state-viewer/test/regressions/replaced-and-disabled-in-one-render.test.tsx",
        "packages/state-viewer/test/regressions/selector-failed-during-preview.test.tsx",
        "packages/state-viewer/test/regressions/stable-observer-actor-replacement.test.tsx",
        "packages/state-viewer/test/regressions/stable-observer-left-on-preview.test.tsx",
        "packages/state-viewer/test/regressions/stable-observer-replaced-while-disabled.test.tsx",
        "packages/state-viewer/test/regressions/stopped-during-preview.test.tsx",
        "packages/state-viewer/test/regressions/stopped-hook-store.test.tsx",
        "packages/state-viewer/test/regressions/stopped-unseen-wake.test.tsx",
        "packages/state-viewer/test/regressions/suspense-hidden-hooks.test.tsx",
        "packages/state-viewer/test/regressions/throwing-observer.test.tsx",
        "packages/state-viewer/test/regressions/topromise-during-preview.test.tsx",
        "packages/state-viewer/test/regressions/uncommitted-render-observers.test.tsx",
        "packages/state-viewer/test/regressions/unhandled-errors.test.tsx",
        "packages/state-viewer/test/regressions/unshowable-preview-released.test.tsx",
        "packages/state-viewer/test/regressions/unsubscribe-on-done-after-preview.test.ts",
        "packages/state-viewer/test/regressions/useactorref-app-stop-during-preview.test.tsx",
        "packages/state-viewer/test/regressions/useactorref-inline-listener-done.test.tsx",
        "packages/state-viewer/test/regressions/useactorref-observer-after-done-previews.test.tsx",
        "packages/state-viewer/test/regressions/useactorref-observer-after-error.test.tsx",
        "packages/state-viewer/test/regressions/useactorref-observer-done.test.tsx",
        "packages/state-viewer/test/regressions/useactorref-observer-restart.test.tsx",
        "packages/state-viewer/test/regressions/waitfor-done-during-preview.test.tsx",
        "packages/state-viewer/test/xstate/helpers.ts",
        "packages/state-viewer/test/xstate/hooks.test.tsx",
        "packages/state-viewer/test/xstate/integration.test.tsx",
        "packages/state-viewer/test/xstate/proxy.test.ts",
        "packages/state-viewer/test/xstate/tree.test.ts"
      ],
      "rules": {
        "no-restricted-imports": "off",
        "no-restricted-properties": "off",
        "vitest/no-restricted-matchers": "off",
        "vitest/expect-expect": "off",
        "vitest/no-conditional-expect": "off",
        "vitest/no-standalone-expect": "off",
        "vitest/require-mock-type-parameters": "off",
        "vitest/require-to-throw-message": "off",
        "vitest/valid-describe-callback": "off",
        "vitest/valid-title": "off"
      }
    }
  ]
}
