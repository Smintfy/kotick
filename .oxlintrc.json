{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "vitest"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/.next/**",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "tools/oxlint/anti-slop/**"
  ],
  "jsPlugins": [
    { "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" }
  ],
  "rules": {
    "import/no-cycle": "error",
    // A comment states its reason itself. It does not cite the MVP spec, because the spec will be deleted.
    // The terms are the section sign, the word "spec", and the ids of the spec's goals, requirements and decisions.
    "no-warning-comments": [
      "error",
      {
        "location": "anywhere",
        "terms": [
          "§", "spec",
          "G1", "G2", "G3", "G4", "G5", "G6", "G7",
          "R1", "R2", "R3", "R4", "R5", "R6", "R7", "R8", "R9", "R10", "R11", "R12", "R13", "R14",
          "R15", "R16", "R17", "R18", "R19", "R20", "R21", "R22", "R23", "R24", "R25", "R26", "R27", "R28",
          "D1", "D2", "D3", "D4", "D5", "D6", "D7", "D8", "D9", "D10", "D11", "D12", "D13",
          "D14", "D15", "D16", "D17", "D18", "D19", "D20", "D21", "D22", "D23", "D24", "D25"
        ]
      }
    ],
    "oxc/no-accumulating-spread": "error",
    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    // The code has no schema library, so a type guard is the parser of a value. A typeof check can be in a type guard.
    "anti-slop/no-runtime-typeof": ["error", { "allowInTypeGuards": true }],
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-readable-spacing": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error"
  },
  "overrides": [
    {
      // Each layer below lists what it may import, so a new layer is banned everywhere until a list names it.
      // A later override replaces the options of a rule that an earlier one set, so each layer repeats its whole list.
      // A file that no later override matches keeps this list. So a new directory imports almost nothing.
      "files": ["packages/shiru/src/**"],
      "rules": {
        "unicorn/filename-case": ["error", { "case": "kebabCase" }],
        // A namespace import of React, which is a CommonJS package, keeps an interop helper in the app's bundle.
        // xstate.ts picks each hook from the namespaces of @xstate/react and ./xstate/hooks, and both are ES modules.
        "import/no-namespace": ["error", { "ignore": ["@xstate/react", "./xstate/hooks"] }],
        "no-restricted-imports": ["error", { "patterns": [
          { "regex": "^(react|react-dom|xstate|@xstate/react)(/|$)", "message": "A new directory imports no React and no XState until its own override allows them." },
          { "group": ["../**", "!../core/**", "!../types"], "message": "A new directory imports only its own files, the core and types.ts until its own override names more." }
        ] }]
      }
    },
    {
      // A top-level file reaches a layer with "./".
      // So "./**" can't mean "my own files" here, as it does in a directory.
      "files": ["packages/shiru/src/*.ts", "packages/shiru/src/*.tsx"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [
          { "regex": "^(react|react-dom|xstate|@xstate/react)(/|$)", "message": "A new top-level file imports no React and no XState until its own override allows them." },
          { "group": ["./**", "../**", "!./core/**", "!./types"], "message": "A new top-level file imports only the core and types.ts until its own override names more." }
        ] }]
      }
    },
    {
      "files": ["packages/shiru/src/core/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [
          { "regex": "^(react|react-dom|xstate|@xstate/react)(/|$)", "message": "The core is in both bundles, so it imports no React and no XState." },
          { "group": ["../**", "!../core/**", "!../types", "!../../package.json"], "message": "The core imports only its own files, types.ts and package.json." }
        ] }]
      }
    },
    {
      // types.ts is a top-level file in the row of the core.
      // So it needs the "./" forms that the override of the core has no use for.
      "files": ["packages/shiru/src/types.ts"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [
          { "regex": "^(react|react-dom|xstate|@xstate/react)(/|$)", "message": "The core is in both bundles, so it imports no React and no XState." },
          { "group": ["./**", "../**", "!./core/**", "!./types", "!../../package.json"], "message": "The core imports only its own files, types.ts and package.json." }
        ] }]
      }
    },
    {
      "files": ["packages/shiru/src/components/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [
          { "regex": "^(xstate|@xstate/react)(/|$)", "message": "The overlay reads actors through types.ts. Only the adapter imports XState." },
          { "group": ["../**", "!../core/**", "!../types", "!../hooks/**", "!../utils/**", "!../shared-hooks/**", "!../styles.generated"], "message": "Components import only their own files, the core, types.ts, hooks, utils, shared hooks and the styles." }
        ] }]
      }
    },
    {
      // The list leaves out components, so it bans them.
      // A second group pattern for them would report each import twice, and a "!" in this list would silence it.
      "files": ["packages/shiru/src/hooks/**", "packages/shiru/src/utils/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [
          { "regex": "^(xstate|@xstate/react)(/|$)", "message": "The overlay reads actors through types.ts. Only the adapter imports XState." },
          { "group": ["../**", "!../core/**", "!../types", "!../hooks/**", "!../utils/**", "!../shared-hooks/**", "!../styles.generated"], "message": "Hooks and utils import only their own files, the core, types.ts, each other, shared hooks and the styles, and never components." }
        ] }]
      }
    },
    {
      "files": ["packages/shiru/src/shared-hooks/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [
          { "regex": "^(react-dom|xstate|@xstate/react)(/|$)", "message": "Shared hooks serve the overlay and the adapters, so they import no react-dom and no XState." },
          { "group": ["../**", "!../core/**", "!../types"], "message": "Shared hooks import only their own files, the core and types.ts." }
        ] }]
      }
    },
    {
      "files": ["packages/shiru/src/xstate/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [
          { "regex": "^react-dom(/|$)", "message": "The adapter renders nothing. The overlay owns the DOM." },
          { "group": ["../**", "!../core/**", "!../types", "!../shared-hooks/**"], "message": "The adapter imports only its own files, the core, types.ts and shared hooks, and never the overlay or the other adapter." }
        ] }]
      }
    },
    {
      "files": ["packages/shiru/src/reducer/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [
          { "regex": "^react-dom(/|$)", "message": "The reducer adapter renders nothing. The overlay owns the DOM." },
          { "regex": "^(xstate|@xstate/react)(/|$)", "message": "The reducer adapter imports no XState." },
          { "group": ["../**", "!../core/**", "!../types", "!../shared-hooks/**"], "message": "The reducer adapter imports only its own files, the core, types.ts and shared hooks, and never the overlay or the other adapter." }
        ] }]
      }
    },
    {
      // Server code imports a machine file, and production builds keep this module.
      // So it stays free of React, of the core and of the other files of its own directory.
      "files": ["packages/shiru/src/reducer/machine.ts"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [
          { "regex": ".", "message": "The definition module imports nothing, so server code can import a machine file." }
        ] }]
      }
    },
    {
      // An entry file lists the files that it may import.
      // "../**" is in the group because "./**" doesn't reach out of src.
      "files": ["packages/shiru/src/index.tsx"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [
          { "regex": "^(xstate|@xstate/react)(/|$)", "message": "The overlay reads actors through types.ts. Only the adapter imports XState." },
          { "group": ["./**", "../**", "!./components/shiru", "!./types"], "message": "shiru exports <Shiru /> and its types. Test a private function through them." }
        ] }]
      }
    },
    {
      "files": ["packages/shiru/src/xstate.ts"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [
          { "regex": "^react-dom(/|$)", "message": "The adapter renders nothing. The overlay owns the DOM." },
          { "group": ["./**", "../**", "!./xstate/connect", "!./xstate/define-fixtures", "!./xstate/hooks", "!./xstate/options"], "message": "shiru/xstate exports the hooks, connect(), defineFixtures() and their types. Test a private function through them." }
        ] }]
      }
    },
    {
      "files": ["packages/shiru/src/reducer.ts"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [
          { "regex": "^react-dom(/|$)", "message": "The reducer adapter renders nothing. The overlay owns the DOM." },
          { "regex": "^(xstate|@xstate/react)(/|$)", "message": "The reducer adapter imports no XState." },
          { "group": ["./**", "../**", "!./reducer/machine", "!./reducer/hook", "!./reducer/define-fixtures"], "message": "shiru/reducer exports defineReducerMachine, useMachineReducer, defineFixtures and their types. Test a private function through them." }
        ] }]
      }
    },
    {
      // shiru/figure is an entry of the workspace for the docs site, and no build has it.
      // It runs XState and reducer machines in the real overlay, so it may import every library and both adapters.
      "files": ["packages/shiru/src/figure.tsx"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [
          { "group": ["./**", "../**", "!./components/**", "!./core/**", "!./types", "!./utils/**", "!./xstate/**", "!./reducer/**"], "message": "shiru/figure imports only the overlay, the core, types.ts, utils and the two adapters, and never another entry." }
        ] }]
      }
    },
    {
      // Tests use the package the way an app does.
      // The rules are in packages/shiru/.claude/skills/writing-tests/SKILL.md.
      "files": ["packages/shiru/test/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "regex": "(^|/)src(/|$)", "message": "Import shiru, shiru/xstate and shiru/reducer by name." }
            ]
          }
        ],
        "no-restricted-properties": [
          "error",
          { "object": "vi", "property": "mock", "message": "No module mocks. Test through the real modules." },
          { "object": "vi", "property": "doMock", "message": "No module mocks. Test through the real modules." },
          { "object": "vi", "property": "hoisted", "message": "No module mocks. Test through the real modules." },
          { "object": "vi", "property": "fn", "message": "No mock functions. Push each call into an array, then assert the array." },
          { "object": "vi", "property": "mocked", "message": "No mock functions. Push each call into an array, then assert the array." },
          { "object": "vi", "property": "spyOn", "message": "No spies. Assert what the code does. Read console output with watchConsole() from test/support/console.ts." },
          { "object": "vi", "property": "stubGlobal", "message": "No stubbed globals. Set up the environment the way a page would." },
          { "object": "vi", "property": "stubEnv", "message": "No stubbed globals. Set up the environment the way a page would." },
          { "object": "vi", "property": "useFakeTimers", "message": "No fake clock. Fire the real event that starts the work, or wait for real time." },
          { "object": "vi", "property": "setSystemTime", "message": "No fake clock. Fire the real event that starts the work, or wait for real time." },
          { "object": "expect", "property": "anything", "message": "Assert the value itself." },
          {
            "object": "globalThis",
            "property": "__SHIRU_REGISTRY__",
            "message": "The registry is private. Read what the overlay shows."
          },
          {
            "object": "window",
            "property": "__SHIRU_REGISTRY__",
            "message": "The registry is private. Read what the overlay shows."
          },
          {
            "object": "globalThis",
            "property": "__SHIRU_LAST_INSTANCE__",
            "message": "The instance counter is private. Read the Instance options that the overlay shows."
          },
          {
            "object": "window",
            "property": "__SHIRU_LAST_INSTANCE__",
            "message": "The instance counter is private. Read the Instance options that the overlay shows."
          }
        ],
        "vitest/no-restricted-matchers": [
          "error",
          {
            "toBeDefined": "Assert the value itself.",
            "toBeTruthy": "Assert the value itself.",
            "not.toBeTruthy": "Assert the value itself.",
            "toBeFalsy": "Assert the value itself.",
            "not.toBeFalsy": "Assert the value itself."
          }
        ]
      }
    },
    {
      // A type test asserts with @ts-expect-error, which expect-expect can't see.
      "files": ["packages/shiru/test/**/*.test-d.ts"],
      "rules": { "vitest/expect-expect": "off" }
    },
    {
      "files": ["packages/shiru/bench/**"],
      "rules": { "vitest/expect-expect": "off" }
    }
  ]
}
