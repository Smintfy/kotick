{
  "name": "state-viewer-repo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter state-viewer --filter vite-react dev",
    "dev:hostile-css": "pnpm --parallel --filter state-viewer --filter hostile-css dev",
    "dev:next": "pnpm --parallel --filter state-viewer --filter next-app dev",
    "dev:site": "pnpm --parallel --filter state-viewer --filter site dev",
    "test": "pnpm lint && pnpm -r test",
    "test:matrix": "node scripts/test-matrix.mjs",
    "check:bundles": "node tests/bundles/check.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.11.2",
  "devDependencies": {
    "oxlint": "^1.88.0"
  }
}
