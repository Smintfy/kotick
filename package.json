{
  "name": "state-viewer-repo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter vite-react dev",
    "dev:hostile-css": "pnpm --filter hostile-css dev",
    "dev:next": "pnpm --filter next-app dev",
    "test": "pnpm -r test",
    "test:matrix": "node scripts/test-matrix.mjs",
    "check:bundles": "node tests/bundles/check.mjs",
    "typecheck": "pnpm -r typecheck"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.11.2"
}
